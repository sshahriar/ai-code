# GeoNews environment (copy to `.env` and edit). Never commit `.env`.
# Free-resource demo (no API quota): set LLM_MOCK=true and INGEST_MOCK=true

# Optional: OpenRouter for live AI briefings (leave empty for mock / no-key path)
OPENROUTER_API_KEY=

# Optional: Guardian Open Platform (free key from open-platform.theguardian.com)
GUARDIAN_API_KEY=

# Required for Nominatim politeness (do not use a generic curl UA)
NOMINATIM_USER_AGENT=GeoNews/0.1 (student-project; contact: local)

# Testing / offline (recommended true for first run, CI, and Playwright)
LLM_MOCK=true
INGEST_MOCK=true

# Optional tuning
INGEST_INTERVAL_SECONDS=900
INGEST_MANUAL_COOLDOWN_SECONDS=30
DEFAULT_LAT=23.8103
DEFAULT_LON=90.4125
DEFAULT_PLACE=Dhaka

# Server (uvicorn usually sets these via CLI flags)
HOST=0.0.0.0
PORT=8000
